{
  "name": "dhmail",
  "productName": "DHMail",
  "version": "1.16.0",
  "description": "DHMail, a desktop mail, calendar and contacts client by Elias De Hondt.",
  "author": "Elias De Hondt",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "main": "dist/main/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "ng build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:renderer": "ng build --watch --configuration development",
    "dist": "npm run build && electron-builder --win",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@angular/animations": "^20.3.34",
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/forms": "^20.3.34",
    "@angular/platform-browser": "^20.3.34",
    "@angular/platform-browser-dynamic": "^20.3.34",
    "@angular/router": "^20.3.34",
    "@ngx-translate/core": "^17.0.0",
    "dompurify": "^3.4.17",
    "ical.js": "^2.2.1",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "rxjs": "~7.8.0",
    "tsdav": "^2.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.40",
    "@angular/cli": "^20.3.40",
    "@angular/compiler-cli": "^20.3.34",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "hoodiecrow-imap": "^3.3.1",
    "smtp-server": "^3.21.4",
    "typescript": "~5.9.3"
  }
}
